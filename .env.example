# email for verified sign-in; prototype for local-only email identity without verification.
VIBEHACK_AUTH_MODE=email
VIBEHACK_PORT=4311
VIBEHACK_DATA_DIR=.data
# Exact browser origin; email sign-in links point here.
BETTER_AUTH_URL=http://127.0.0.1:4310
# Local startup generates and persists a secret when omitted.
# Set a durable secret through your secret manager for deployed installations.
# BETTER_AUTH_SECRET=
# Choose disabled, smtp, or resend. See docs/authentication.md.
VIBEHACK_EMAIL_PROVIDER=disabled
# VIBEHACK_EMAIL_FROM=VibeHack <signin@your-domain.example>
# Resend API adapter:
# RESEND_API_KEY=
# SMTP adapter (Brevo or another provider):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Per-IP/path login requests per minute; allows shared event Wi-Fi.
VIBEHACK_AUTH_REQUESTS_PER_MINUTE=120
# Existing sprite CLI authentication supplies cloud access.
# VIBEHACK_SPRITE_ORG=
# With cloud workspaces enabled, first opening a team workspace provisions its Sprite.
VIBEHACK_ENABLE_SPRITES=0
